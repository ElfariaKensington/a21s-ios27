+                snprintf(opath, sizeof(opath), "%s/c%d.bin", argv[2], cur_part);
+                of = fopen(opath, "wb");
+                if (!of) return 6;
+            }
+            outbuf[outn++] = w;
+            if (outn == 16384) {
+                fwrite(outbuf, 4, outn, of);
+                outn = 0;
+            }
+            idx++;
+        }
+    }
+    if (of) {
+        if (outn) fwrite(outbuf, 4, outn, of);
+        fclose(of);
+    }
+    free(bits);
+    return 0;
+}
