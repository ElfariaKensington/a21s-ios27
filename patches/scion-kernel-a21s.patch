+#include <sys/sysctl.h>
 #include <unistd.h>
 
+static double g_sb_backdrop_max = 0.25;
+static double (*g_orig_backdrop_scale)(id, SEL);
+static void (*g_orig_backdrop_setScale)(id, SEL, double);
+static id (*g_orig_backdrop_defaultVal)(id, SEL, NSString *);
+
+static double sb_hook_backdrop_scale(id self, SEL _cmd)
+{
+	double s = g_orig_backdrop_scale ? g_orig_backdrop_scale(self, _cmd) : g_sb_backdrop_max;
+	if (s <= 0.0 || s > g_sb_backdrop_max)
+		s = g_sb_backdrop_max;
+	return s;
+}
+
+static void sb_hook_backdrop_setScale(id self, SEL _cmd, double s)
+{
+	if (s > g_sb_backdrop_max)
+		s = g_sb_backdrop_max;
+	if (g_orig_backdrop_setScale)
+		g_orig_backdrop_setScale(self, _cmd, s);
+}
+
+static id sb_hook_backdrop_defaultVal(id self, SEL _cmd, NSString *key)
+{
+	if (key && [key isEqualToString:@"scale"])
+		return @(g_sb_backdrop_max);
+	return g_orig_backdrop_defaultVal ? g_orig_backdrop_defaultVal(self, _cmd, key) : nil;
+}
+
+void sb_backdrop_clamp_init(void)
+{
+	/* Enable Accessibility Reduce Transparency on Mali-G52 MP1 unless disabled via no-reduce-transparency,
+	 * so CoreAnimation Metal draws crisp solid platters without heavy multi-pass Gaussian blur stalls. */
+	if (strcmp(getprogname(), "SpringBoard") == 0 && access("/private/var/local/no-reduce-transparency", F_OK) != 0) {
+		{
+			void *ah = dlopen("/usr/lib/libAccessibility.dylib", RTLD_LAZY);
+			void (*set_rt)(unsigned char) = (void (*)(unsigned char))dlsym(ah ? ah : RTLD_DEFAULT, "_AXSSetEnhanceBackgroundContrastEnabled");
+			unsigned char (*get_rt)(void) = (unsigned char (*)(void))dlsym(ah ? ah : RTLD_DEFAULT, "_AXSEnhanceBackgroundContrastEnabled");
+			int before = get_rt ? (int)get_rt() : -1;
+			if (set_rt)
+				set_rt(1);
+			int after = get_rt ? (int)get_rt() : -1;
+			int rfd = open("/dev/console", O_WRONLY | O_NOCTTY | O_NONBLOCK);
+			if (rfd >= 0) {
+				dprintf(rfd, "SBBD[%d]: Reduce Transparency ah=%p set=%p before=%d after=%d\n", getpid(), ah, (void *)set_rt, before, after);
+				close(rfd);
+			}
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+				if (set_rt)
+					set_rt(1);
+			});
+		}
+	}
+	double want = 0.25;
+	int sfd = open("/private/var/local/backdrop-scale", O_RDONLY);
+	if (sfd >= 0) {
+		char buf[32] = { 0 };
+		ssize_t n = read(sfd, buf, sizeof(buf) - 1);
+		close(sfd);
+		if (n > 0)
+			want = strtod(buf, NULL);
+	}
+	if (want <= 0.0 || want >= 1.0)
+		return;
+	Class cls = objc_getClass("CABackdropLayer");
+	if (!cls)
+		return;
+	g_sb_backdrop_max = want;
+	SEL scaleSel = sel_registerName("scale");
+	Method mGet = class_getInstanceMethod(cls, scaleSel);
+	if (mGet)
+		g_orig_backdrop_scale = (double (*)(id, SEL))method_setImplementation(mGet, (IMP)sb_hook_backdrop_scale);
+	SEL setScaleSel = sel_registerName("setScale:");
+	Method mSet = class_getInstanceMethod(cls, setScaleSel);
+	if (mSet)
+		g_orig_backdrop_setScale = (void (*)(id, SEL, double))method_setImplementation(mSet, (IMP)sb_hook_backdrop_setScale);
+
+	Class meta = object_getClass((id)cls);
+	SEL defSel = sel_registerName("defaultValueForKey:");
+	Method mDef = meta ? class_getInstanceMethod(meta, defSel) : NULL;
+	if (mDef) {
+		IMP oldDef = method_getImplementation(mDef);
+		g_orig_backdrop_defaultVal = (id (*)(id, SEL, NSString *))oldDef;
+		if (!class_addMethod(meta, defSel, (IMP)sb_hook_backdrop_defaultVal, method_getTypeEncoding(mDef)))
+			method_setImplementation(mDef, (IMP)sb_hook_backdrop_defaultVal);
+	}
+
+	SEL initSel = @selector(init);
+	Method mInit = class_getInstanceMethod(cls, initSel);
+	if (mInit && g_orig_backdrop_setScale) {
+		IMP origInit = method_getImplementation(mInit);
+		IMP newInit = imp_implementationWithBlock(^id(id me) {
+			id obj = ((id (*)(id, SEL))origInit)(me, initSel);
+			if (obj && g_orig_backdrop_setScale)
+				g_orig_backdrop_setScale(obj, setScaleSel, g_sb_backdrop_max);
+			return obj;
+		});
+		if (!class_addMethod(cls, initSel, newInit, method_getTypeEncoding(mInit)))
+			method_setImplementation(mInit, newInit);
+	}
+	int cfd = open("/dev/console", O_WRONLY | O_NOCTTY | O_NONBLOCK);
+	if (cfd >= 0) {
+		dprintf(cfd, "SBBD[%d %s]: CABackdropLayer scale clamped <= %.3f\n", getpid(), getprogname(), g_sb_backdrop_max);
+		close(cfd);
+	}
+}
