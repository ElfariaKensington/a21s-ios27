 }
+
+/* ---- Samsung Exynos 850 (S5E3830, Galaxy A21s SM-A217F): DWC3 @ 0x13600000, USBCON v2.00 @ 0x135d0000 ---- */
+#define E850_DWC3_PA            0x13600000u
+#define E850_USBCON_PA          0x135d0000u
+#define E850_PMU_PA             0x11860000u
+#define E850_PMU_USB_PHY        0x0704u
+#define E850_PMU_HSI_CONF       0x1c80u
+#define E850_PMU_HSI_STAT       0x1c84u
+#define E850_DTZPC_HSI          0x13410204u
+#define E850_CMU_HSI_PA         0x13400000u
+#define E850_HSI_BUS_USER       0x0600u
+#define E850_HSI_USB_USER       0x0620u
+#define E850_HSI_QCH_REFCLK     0x3000u
+#define E850_HSI_QCH_RTC        0x3004u
+#define E850_HSI_QCH_20CTRL     0x3030u
+#define E850_HSI_QCH_LINK       0x3034u
+#define E850_HSP_PLL            0x0028u
+#define E850_PINCTRL_PERI_PA    0x139b0000u
+#define E850_GPP0_CON           0x0020u         /* gpp0-0 = i2c0 SDA, gpp0-1 = i2c0 SCL (s2mu106 @ 0x3d) */
+#define E850_GPP0_DAT           0x0024u
+#define E850_GPP0_PUD           0x0028u
+#define S2MPU12_LDO1_CTRL       0x2bu           /* vdd085_usb20 */
+#define S2MPU12_LDO2_CTRL       0x2cu           /* vdd18_usb20 */
+#define S2MPU12_LDO11_CTRL      0x35u           /* vdd30_usb20 */
+#define S2MU106_ADDR            0x3du
+
+static vm_offset_t e850_pmu, e850_hsi, e850_usbcon, e850_pinctrl;
+static bool e850_mapped;
+
+/* Open-drain I2C master on GPP0[0]=SDA, GPP0[1]=SCL (external board pull-ups; CON 0=in/high, 1=out/low). */
+static inline void
+e850_sda(bool high)
+{
+	uint32_t c = rd(e850_pinctrl, E850_GPP0_CON) & ~0xfu;
+	wr(e850_pinctrl, E850_GPP0_CON, c | (high ? 0u : 1u));
+}
+
+static inline void
+e850_scl(bool high)
+{
+	uint32_t c = rd(e850_pinctrl, E850_GPP0_CON) & ~0xf0u;
+	wr(e850_pinctrl, E850_GPP0_CON, c | (high ? 0u : 0x10u));
+	if (high) {
+		for (unsigned i = 0; i < 50 && !(rd(e850_pinctrl, E850_GPP0_DAT) & 2u); i++) {
+			delay(1);
+		}
+	}
+}
+
+static inline bool
+e850_sda_in(void)
+{
+	return (rd(e850_pinctrl, E850_GPP0_DAT) & 1u) != 0;
+}
+
+static void
+e850_i2c_start(void)
+{
+	e850_sda(true);
+	e850_scl(true);
+	delay(5);
+	e850_sda(false);
+	delay(5);
+	e850_scl(false);
+	delay(5);
+}
+
+static void
+e850_i2c_stop(void)
+{
+	e850_sda(false);
+	delay(5);
+	e850_scl(true);
+	delay(5);
+	e850_sda(true);
+	delay(5);
+}
+
+static bool
+e850_i2c_tx(uint8_t byte)
+{
+	for (int b = 7; b >= 0; b--) {
+		e850_sda(((byte >> b) & 1u) != 0);
+		delay(5);
+		e850_scl(true);
+		delay(5);
+		e850_scl(false);
+	}
+	e850_sda(true);
+	delay(5);
+	e850_scl(true);
+	delay(5);
+	bool ack = !e850_sda_in();
+	e850_scl(false);
+	delay(5);
+	return ack;
+}
+
+static uint8_t
+e850_i2c_rx(bool ack)
+{
+	uint8_t val = 0;
+	e850_sda(true);
+	for (int b = 7; b >= 0; b--) {
+		delay(5);
+		e850_scl(true);
+		delay(5);
+		if (e850_sda_in()) {
+			val |= (uint8_t)(1u << b);
+		}
+		e850_scl(false);
+	}
+	e850_sda(!ack);
+	delay(5);
+	e850_scl(true);
+	delay(5);
+	e850_scl(false);
+	e850_sda(true);
+	delay(5);
+	return val;
+}
+
+static bool
+e850_muic_read(uint8_t reg, uint8_t *out)
+{
+	e850_i2c_start();
+	if (!e850_i2c_tx((uint8_t)(S2MU106_ADDR << 1)) || !e850_i2c_tx(reg)) {
+		e850_i2c_stop();
+		return false;
+	}
+	e850_i2c_start();
+	if (!e850_i2c_tx((uint8_t)((S2MU106_ADDR << 1) | 1u))) {
+		e850_i2c_stop();
+		return false;
+	}
+	*out = e850_i2c_rx(false);
+	e850_i2c_stop();
+	return true;
+}
+
+static bool
+e850_muic_write(uint8_t reg, uint8_t val)
+{
+	e850_i2c_start();
+	bool ok = e850_i2c_tx((uint8_t)(S2MU106_ADDR << 1)) && e850_i2c_tx(reg) && e850_i2c_tx(val);
+	e850_i2c_stop();
+	return ok;
+}
+
+/*
+ * Android's s2mu106_muic_shutdown writes MANUAL_SW_CTRL (0x70) = 0x00 (open), MUIC_CTRL1 (0x6d) |= 0x04,
+ * and CHG_DET (0x7f) &= ~0x40 on reboot, leaving D+/D- disconnected from the AP. Route D+/D- to USB_AP
+ * (0x70 = (v & 3) | 0x24) in manual-switch mode (0x6d &= ~0x04) so the host sees our pull-up immediately.
+ */
+static void
+e850_muic_route_usb(usb_glue_say_t say)
+{
+	if (!e850_pinctrl) {
+		return;
+	}
+	uint32_t save_con = rd(e850_pinctrl, E850_GPP0_CON);
+	uint32_t save_dat = rd(e850_pinctrl, E850_GPP0_DAT);
+
+	wr(e850_pinctrl, E850_GPP0_DAT, save_dat & ~3u);
+	e850_sda(true);
+	e850_scl(true);
+	delay(10);
+	for (unsigned i = 0; i < 9 && !e850_sda_in(); i++) {
+		e850_scl(false);
+		delay(5);
+		e850_scl(true);
+		delay(5);
+	}
+	e850_i2c_stop();
+
+	uint8_t id = 0xff, r4f = 0, r6d = 0, r70 = 0, r7f = 0;
+	bool ok = e850_muic_read(0x00, &id) && e850_muic_read(0x4f, &r4f) &&
+	    e850_muic_read(0x6d, &r6d) && e850_muic_read(0x70, &r70) && e850_muic_read(0x7f, &r7f);
+	if (ok) {
+		if (r4f & 0x01u) {
+			(void)e850_muic_write(0x4f, (uint8_t)(r4f & ~0x01u));
+		}
+		(void)e850_muic_write(0x7f, (uint8_t)(r7f | 0x40u));
+		(void)e850_muic_write(0x70, (uint8_t)((r70 & 0x03u) | 0x24u));
+		(void)e850_muic_write(0x6d, (uint8_t)((r6d ? r6d : 0x12u) & ~0x04u));
+		uint8_t n6d = 0, n70 = 0, n7f = 0;
+		(void)e850_muic_read(0x6d, &n6d);
+		(void)e850_muic_read(0x70, &n70);
+		(void)e850_muic_read(0x7f, &n7f);
+		say("usb: exynos850: s2mu106 MUIC (i2c0 0x3d): id=%02x 4f=%02x 6d=%02x->%02x 70=%02x->%02x 7f=%02x->%02x\n",
+		    id, r4f, r6d, n6d, r70, n70, r7f, n7f);
+	} else {
+		say("usb: exynos850: s2mu106 MUIC (i2c0 0x3d): no ACK (GPP0 CON=%08x DAT=%08x)\n", save_con, save_dat);
+	}
+
+	wr(e850_pinctrl, E850_GPP0_DAT, save_dat);
+	wr(e850_pinctrl, E850_GPP0_CON, save_con);
+}
+
+static uint64_t
+e850_smc(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+static bool
+e850_map_and_power(usb_glue_say_t say)
+{
+	if (!e850_mapped) {
+		e850_pmu = ml_io_map(E850_PMU_PA, 0x3000);
+		e850_hsi = ml_io_map(E850_CMU_HSI_PA, 0x4000);
+		e850_usbcon = ml_io_map(E850_USBCON_PA, 0x1000);
+		e850_pinctrl = ml_io_map(E850_PINCTRL_PERI_PA, 0x1000);
+		if (!e850_pmu || !e850_hsi || !e850_usbcon) {
+			say("usb: exynos850: MMIO map failed\n");
+			return false;
+		}
+		e850_mapped = true;
+	}
+	if (!(rd(e850_pmu, E850_PMU_HSI_STAT) & 1u)) {
+		wr(e850_pmu, E850_PMU_HSI_CONF, rd(e850_pmu, E850_PMU_HSI_CONF) | 1u);
+		for (unsigned us = 0; us < 50000 && !(rd(e850_pmu, E850_PMU_HSI_STAT) & 1u); us += 10) {
+			delay(10);
+		}
+		if (!(rd(e850_pmu, E850_PMU_HSI_STAT) & 1u)) {
+			say("usb: exynos850: pd-hsi did not power on (stat=%08x)\n", rd(e850_pmu, E850_PMU_HSI_STAT));
+			return false;
+		}
+		uint64_t rc = e850_smc(0x82000410ULL, 1ULL, E850_DTZPC_HSI, 0ULL);
+		say("usb: exynos850: pd-hsi powered on, DTZPC SMC=%#llx\n", rc);
+	}
+	wr(e850_hsi, E850_HSI_BUS_USER, rd(e850_hsi, E850_HSI_BUS_USER) | USER_MUX_SEL);
+	wr(e850_hsi, E850_HSI_USB_USER, rd(e850_hsi, E850_HSI_USB_USER) | USER_MUX_SEL);
+	wr(e850_hsi, E850_HSI_QCH_REFCLK, rd(e850_hsi, E850_HSI_QCH_REFCLK) | 3u);
+	wr(e850_hsi, E850_HSI_QCH_RTC, rd(e850_hsi, E850_HSI_QCH_RTC) | 3u);
+	wr(e850_hsi, E850_HSI_QCH_20CTRL, rd(e850_hsi, E850_HSI_QCH_20CTRL) | 3u);
+	wr(e850_hsi, E850_HSI_QCH_LINK, rd(e850_hsi, E850_HSI_QCH_LINK) | 3u);
+	delay(20);
+	return true;
+}
+
+static bool
+e850_look(usb_glue_say_t say, __unused uint32_t flags)
+{
+	if (!e850_map_and_power(say)) {
+		return false;
+	}
+	uint32_t iso = rd(e850_pmu, E850_PMU_USB_PHY);
+	uint32_t test = rd(e850_usbcon, HSP_TEST);
+	say("usb: exynos850: PMU +0x704=%08x pd-hsi=%08x HSI user=%08x/%08x USBCON VER=%08x CLKRST=%08x UTMI=%08x HSP=%08x TUNE=%08x TEST=%08x (line %s)\n",
+	    iso, rd(e850_pmu, E850_PMU_HSI_STAT), rd(e850_hsi, E850_HSI_BUS_USER), rd(e850_hsi, E850_HSI_USB_USER),
+	    rd(e850_usbcon, CTRL_VER), rd(e850_usbcon, CLKRST), rd(e850_usbcon, UTMI), rd(e850_usbcon, HSP),
+	    rd(e850_usbcon, HSP_TUNE), test, linestates[HSP_TEST_LINESTATE(test)]);
+	return true;
+}
+
+static int
+e850_phy_on(usb_glue_say_t say, __unused uint32_t flags)
+{
+	if (!e850_map_and_power(say)) {
+		return ENXIO;
+	}
+
+	/* 1. Ensure S2MPU12 USB20 PHY LDO1 (0.85V), LDO2 (1.8V), LDO11 (3.0V) are enabled (mode 3 = 0xc0). */
+	{
+		extern bool starlte_pmic_read(uint32_t type, uint32_t reg, uint8_t *val);
+		extern bool starlte_pmic_write(uint32_t type, uint32_t reg, uint8_t val);
+		static const struct { uint8_t num, reg; } ldos[3] = {
+			{ 1, S2MPU12_LDO1_CTRL }, { 2, S2MPU12_LDO2_CTRL }, { 11, S2MPU12_LDO11_CTRL }
+		};
+		for (unsigned i = 0; i < 3; i++) {
+			uint8_t b = 0, a = 0;
+			bool okr = starlte_pmic_read(1, ldos[i].reg, &b);
+			if (okr && (b & 0xc0u) != 0xc0u) {
+				(void)starlte_pmic_write(1, ldos[i].reg, (uint8_t)(b | 0xc0u));
+			}
+			(void)starlte_pmic_read(1, ldos[i].reg, &a);
+			say("usb: exynos850: S2MPU12 LDO%u (%#x): %s %02x -> %02x\n",
+			    ldos[i].num, ldos[i].reg, okr ? "ok" : "err", b, a);
+		}
+		delay(200);
+	}
+
+	/* 2. Route USB-C D+/D- through s2mu106 MUIC to AP USB. */
+	e850_muic_route_usb(say);
+
+	/* 3. Release PMU USB20 PHY isolation and run Samsung CAL v3.01 (DT phy_version = 0x301) sequence. */
+	wr(e850_pmu, E850_PMU_USB_PHY, rd(e850_pmu, E850_PMU_USB_PHY) | PMU_ISOL_BIT);
+	delay(50);
+
+	uint32_t lc = (rd(e850_usbcon, LINK_CTRL) & ~0x1f00u) | 0x1e00u;
+	delay(500);
+	wr(e850_usbcon, LINK_CTRL, lc);
+	delay(500);
+	wr(e850_usbcon, LINK_CTRL, rd(e850_usbcon, LINK_CTRL) | LC_FORCE_QACT);
+	delay(500);
+
+	uint32_t cr = rd(e850_usbcon, CLKRST);
+	wr(e850_usbcon, CLKRST, cr | CR_LINK_SW_RST);
+	delay(10);
+	wr(e850_usbcon, CLKRST, cr & ~CR_LINK_SW_RST);
+
+	/* Assert PHY20_SW_RST | PHY20_RST_SEL | PORT_RST (0x300c for DT phy_version = 0x301). */
+	wr(e850_usbcon, CLKRST, rd(e850_usbcon, CLKRST) | 0x300cu);
+	wr(e850_usbcon, UTMI, rd(e850_usbcon, UTMI) & ~0xfu);
+	wr(e850_usbcon, HSP, rd(e850_usbcon, HSP) | HSP_EN_UTMISUSPEND | HSP_COMMONONN);
+	wr(e850_usbcon, PWR, rd(e850_usbcon, PWR) & ~0xf8u);
+	wr(e850_usbcon, HSP_TEST, rd(e850_usbcon, HSP_TEST) & ~HSP_TEST_SIDDQ);
+	delay(150);
+
+	wr(e850_usbcon, LINK_CTRL, rd(e850_usbcon, LINK_CTRL) | LC_BUS_FILTER_BYPASS);
+	wr(e850_usbcon, UTMI, rd(e850_usbcon, UTMI) | UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+	wr(e850_usbcon, HSP, rd(e850_usbcon, HSP) | HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT);
+	delay(20);
+
+	/* Deassert PHY20_SW_RST & PORT_RST while keeping PHY20_RST_SEL (0x1000). */
+	wr(e850_usbcon, CLKRST, (rd(e850_usbcon, CLKRST) & ~0x300au) | 0x1000u);
+	delay(100);
+
+	wr(e850_usbcon, E850_HSP_PLL, rd(e850_usbcon, E850_HSP_PLL) & ~0x113u);
+	wr(e850_usbcon, LINK_PORT, (rd(e850_usbcon, LINK_PORT) & ~0xcu) | LP_SEL_OCD_U3 | LP_SEL_OCD_U2);
+	wr(e850_usbcon, LINK_CTRL, (rd(e850_usbcon, LINK_CTRL) & ~(7u << 16)) | LC_PIPE3_FORCE_EN | LC_FORCE_RX_ELEC_IDLE);
+	wr(e850_usbcon, COMBO_PMA_CTRL, rd(e850_usbcon, COMBO_PMA_CTRL) | PMA_LOW_PWRN);
+
+	uint32_t test = rd(e850_usbcon, HSP_TEST);
+	say("usb: exynos850: PHY up: CLKRST=%08x LINK_CTRL=%08x PWR=%08x UTMI=%08x HSP=%08x TEST=%08x (SIDDQ %u, line %s)\n",
+	    rd(e850_usbcon, CLKRST), rd(e850_usbcon, LINK_CTRL), rd(e850_usbcon, PWR), rd(e850_usbcon, UTMI),
+	    rd(e850_usbcon, HSP), test, (test & HSP_TEST_SIDDQ) ? 1 : 0, linestates[HSP_TEST_LINESTATE(test)]);
+	return 0;
+}
+
+static void
+e850_phy_state(char *out, unsigned size)
+{
+	if (!e850_mapped) {
+		snprintf(out, size, "(not mapped)");
+		return;
+	}
+	uint32_t test = rd(e850_usbcon, HSP_TEST), utmi = rd(e850_usbcon, UTMI);
+	snprintf(out, size, "line %s, UTMI %08x, SIDDQ %u", linestates[HSP_TEST_LINESTATE(test)],
+	    utmi, (test & HSP_TEST_SIDDQ) ? 1 : 0);
+}
+
+static void
+e850_phy_off(void)
+{
+	if (!e850_mapped) {
+		return;
+	}
+	wr(e850_usbcon, PWR, rd(e850_usbcon, PWR) | 0xf8u);
+	wr(e850_usbcon, HSP_TEST, rd(e850_usbcon, HSP_TEST) | HSP_TEST_SIDDQ);
+	wr(e850_pmu, E850_PMU_USB_PHY, rd(e850_pmu, E850_PMU_USB_PHY) & ~PMU_ISOL_BIT);
+}
+
+static const struct hakios_usb_glue exynos850_glue = {
+	.name = "exynos850",
+	.dwc3_pa = E850_DWC3_PA,
+	.dwc3_size = DWC3_SIZE,
+	.look = e850_look,
+	.phy_on = e850_phy_on,
+	.phy_state = e850_phy_state,
+	.phy_off = e850_phy_off,
+};
+
+const struct hakios_usb_glue *
+hakios_usb_glue_exynos850(void)
+{
+	return &exynos850_glue;
+}
