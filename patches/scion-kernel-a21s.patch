diff --git a/drivers/usb/hakios.exynos_usb.c b/drivers/usb/hakios.exynos_usb.c
index 7a67f68..ae6b35c 100644
--- a/drivers/usb/hakios.exynos_usb.c
+++ b/drivers/usb/hakios.exynos_usb.c
@@ -389,3 +389,378 @@ hakios_usb_glue_exynos9810(void)
 {
