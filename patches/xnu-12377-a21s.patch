+static int a21s_mmc_dma_read_chunk(uint64_t lba, uint32_t n, uint8_t *buf) {
+	uintptr_t bounce_va = (uintptr_t)(su.dma + DMA_BOUNCE);
+	uintptr_t bva = (uintptr_t)buf;
+	uint32_t total = n * 512u;
+	if (!su.dma || !su.dma_pa || bva < bounce_va || bva + total > bounce_va + BOUNCE_SIZE) {
+		return ENOTSUP;
+	}
+	if (((a21s_mr(MMC_HCON) >> 27) & 1u) == 0) {
+		return ENOTSUP;
+	}
+	uint64_t dst_pa = su.dma_pa + DMA_BOUNCE + (uint64_t)(bva - bounce_va);
+	uint64_t desc_pa = su.dma_pa + DMA_UTRL;
+	struct a21s_idmac_desc64 *desc = (struct a21s_idmac_desc64 *)(su.dma + DMA_UTRL);
+	uint32_t ndesc = (total + 4095u) / 4096u;
+	if (ndesc == 0 || ndesc * sizeof(*desc) > DMA_BOUNCE) {
+		return ENOTSUP;
+	}
+	if (a21s_mmc_wait_idle(500)) {
+		return EIO;
+	}
+	for (uint32_t i = 0, rem = total; i < ndesc; i++) {
+		uint32_t seg = rem > 4096u ? 4096u : rem;
+		uint64_t seg_pa = dst_pa + (uint64_t)i * 4096ULL;
+		uint64_t next_pa = (i + 1 < ndesc) ? (desc_pa + (uint64_t)(i + 1) * sizeof(*desc)) : 0ULL;
+		desc[i].des0 = (1u << 31) | (1u << 4) | (i == 0 ? (1u << 3) : 0u) |
+		    ((i + 1 == ndesc) ? (1u << 2) : (1u << 1));
+		desc[i].des1 = 0;
+		desc[i].des2 = seg;
+		desc[i].des3 = 0;
+		desc[i].des4 = (uint32_t)seg_pa;
+		desc[i].des5 = (uint32_t)(seg_pa >> 32);
+		desc[i].des6 = (uint32_t)next_pa;
+		desc[i].des7 = (uint32_t)(next_pa >> 32);
+		rem -= seg;
+	}
+	clean_dcache64((addr64_t)desc_pa, (uint32_t)(ndesc * sizeof(*desc)), TRUE);
+	flush_dcache64((addr64_t)dst_pa, total, TRUE);
+	__builtin_arm_dsb(0xf);
+
+	a21s_mw(MMC_CTRL, (a21s_mr(MMC_CTRL) & ~(1u << 4)) | (1u << 1) | (1u << 2));
+	for (int i = 0; i < 100000 && (a21s_mr(MMC_CTRL) & ((1u << 1) | (1u << 2))); i++) {}
+	a21s_mw(MMC_BMOD, a21s_mr(MMC_BMOD) | 1u);
+	for (int i = 0; i < 100000 && (a21s_mr(MMC_BMOD) & 1u); i++) {}
+	a21s_mw(MMC_RINTSTS, 0xffffffffu);
+	a21s_mw(MMC_IDSTS64, 0xffffffffu);
+	a21s_mw(MMC_IDINTEN64, 0x337u);
+	a21s_mw(MMC_DBADDRL, (uint32_t)desc_pa);
+	a21s_mw(MMC_DBADDRU, (uint32_t)(desc_pa >> 32));
+	a21s_mw(MMC_CTRL, (a21s_mr(MMC_CTRL) & ~(1u << 4)) | (1u << 25));
+	a21s_mw(MMC_BMOD, (a21s_mr(MMC_BMOD) & ~1u) | (1u << 7) | (1u << 1));
+	a21s_mw(MMC_BLKSIZ, 512);
+	a21s_mw(MMC_BYTCNT, total);
+
+	uint32_t cmd = (n == 1)
+	    ? (17u | MMC_CMD_RESP | MMC_CMD_CRC | MMC_CMD_DATA | MMC_CMD_WAITPRV)
+	    : (18u | MMC_CMD_RESP | MMC_CMD_CRC | MMC_CMD_DATA | MMC_CMD_WAITPRV | MMC_CMD_AUTOSTOP);
+	uint64_t t = a21s_ms_now() + 1000;
+	a21s_mw(MMC_CMDARG, (uint32_t)lba);
+	a21s_mw(MMC_CMD, cmd | MMC_CMD_START | MMC_CMD_HOLD);
+	a21s_mw(MMC_PLDMND, 1u);
+	int rc = 0;
+	while (a21s_mr(MMC_CMD) & MMC_CMD_START) {
+		if (a21s_ms_now() > t) {
+			rc = EIO;
+			goto out_dma;
+		}
+	}
+	{
+		uint64_t deadline = a21s_ms_now() + 3000 + n;
+		bool can_nap = (n >= 16) && su.ready && ml_get_interrupts_enabled() &&
+		    !ml_at_interrupt_context() && get_preemption_level() == 0;
+		for (;;) {
+			uint32_t s = a21s_mr(MMC_RINTSTS);
+			uint32_t idsts = a21s_mr(MMC_IDSTS64);
+			if ((s & MMC_INT_ERR) || (idsts & ((1u << 2) | (1u << 4) | (1u << 5)))) {
+				printf("A21S EMMC: dma err rint=%#x idsts=%#x lba=%#llx n=%u\n", s, idsts, lba, n);
+				rc = EIO;
+				goto out_dma;
+			}
+			if (s & MMC_INT_DTO) {
+				break;
+			}
+			if (a21s_ms_now() > deadline) {
+				printf("A21S EMMC: dma timeout rint=%#x idsts=%#x lba=%#llx n=%u\n", s, idsts, lba, n);
+				rc = ETIMEDOUT;
+				goto out_dma;
+			}
+			if (can_nap) {
+				delay(4);
+			}
+		}
+		if (n > 1) {
+			uint64_t t3 = a21s_ms_now() + 500;
+			while (!(a21s_mr(MMC_RINTSTS) & MMC_INT_ACD) && a21s_ms_now() < t3) {}
+		}
+	}
+	flush_dcache64((addr64_t)dst_pa, total, TRUE);
+	__builtin_arm_dsb(0xf);
+	su.ncmds++;
+	su.last_lba = lba;
+
+out_dma:
+	a21s_mw(MMC_BMOD, a21s_mr(MMC_BMOD) & ~(1u << 7));
+	a21s_mw(MMC_CTRL, (a21s_mr(MMC_CTRL) & ~(1u << 25)) | (1u << 1) | (1u << 2));
+	for (int i = 0; i < 100000 && (a21s_mr(MMC_CTRL) & ((1u << 1) | (1u << 2))); i++) {}
+	a21s_mw(MMC_IDINTEN64, 0);
+	a21s_mw(MMC_IDSTS64, 0xffffffffu);
+	a21s_mw(MMC_RINTSTS, 0xffffffffu);
+	return rc;
+}
