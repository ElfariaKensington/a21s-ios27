+	vm_size_t map_sz = (page_off + sizeof(struct a21s_mbox_ring) + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
+	vm_offset_t base = ml_io_map_wcomb((vm_offset_t)(pa & ~(PAGE_SIZE - 1)), map_sz);
+	if (!base) {
