+	if (s & MMC_INT_RTO) { a21s_mw(MMC_RINTSTS, 0xffffffffu); return -4; }
+	if (s & (MMC_INT_RCRC | MMC_INT_RE)) { a21s_mw(MMC_RINTSTS, 0xffffffffu); return -5; }
