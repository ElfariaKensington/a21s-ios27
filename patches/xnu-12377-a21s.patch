+				starlte_return_to_recovery();
+				chord_at = 0;
+			}
+		}
+		if (mb->chip != last_chip) {
+			last_chip = mb->chip;
+			printf("A21S INPUT: HX83112A touch controller %s (irqs=%llu frames=%llu)\n",
+			    last_chip ? "online" : "offline", mb->irqs, mb->frames);
+		}
+		st_msleep(2);
+	}
