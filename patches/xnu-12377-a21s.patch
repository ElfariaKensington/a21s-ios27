+static int a21s_mmc_wait_idle(uint32_t ms) {
+	uint64_t t = a21s_ms_now() + ms;
+	while (a21s_mr(MMC_STATUS) & ((1u << 9) | (1u << 10))) {
+		if (a21s_ms_now() > t) return -1;
